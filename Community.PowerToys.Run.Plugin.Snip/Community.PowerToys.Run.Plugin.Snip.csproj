<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Standalone build of the Snip PowerToys Run plugin.

    The plugin references the assemblies shipped with an installed PowerToys
    instead of the PowerToys source tree, so this repository builds on its own.
    Point PowerToysInstallDir at a different install if needed:

        dotnet build -p:PowerToysInstallDir="D:\PowerToys"
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Community.PowerToys.Run.Plugin.Snip</RootNamespace>
    <AssemblyName>Community.PowerToys.Run.Plugin.Snip</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!--
      Copy NuGet dependencies (WeChatOcr, Sdcb.HyMT2Sharp, Google.Protobuf, Newtonsoft.Json) next to
      the plugin and emit a .deps.json, so PowerToys Run can resolve them from the
      plugin folder when plugin.json sets "DynamicLoading": true.
    -->
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- Same analyzer bar as the PowerToys repository build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0436</NoWarn>

    <!-- Install of the PowerToys build this plugin targets. -->
    <PowerToysInstallDir Condition="'$(PowerToysInstallDir)' == ''">C:\Program Files\PowerToys</PowerToysInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.102">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      Text extraction (OCR). The package ships its OCR component (WeChatOCR.exe,
      mmmojo DLLs, model files) as content files copied to wco_data\ on build.
      Release pack scripts emit a slim zip without wco_data (OCR downloads on
      first use into LocalAppData) and a full zip that keeps wco_data.
    -->
    <PackageReference Include="WeChatOcr" Version="1.0.5" />

    <!--
      In-process Hunyuan MT2 translator (Apache-2.0). Weights are NOT referenced:
      the user supplies a GGUF path in settings (Sdcb.GgufWeights.* would add ~573MB).
    -->
    <PackageReference Include="Sdcb.HyMT2Sharp" Version="2.0.0" />

    <!-- Scroll-capture FFT phase correlation (same as TDS). Copied locally via DynamicLoading. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <!--
    Provided by PowerToys at runtime: do not copy them into the plugin folder, so
    the plugin load context always binds to the host's copies.
  -->
  <ItemGroup>
    <Reference Include="Wox.Plugin">
      <HintPath>$(PowerToysInstallDir)\Wox.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PowerToys.ManagedCommon">
      <HintPath>$(PowerToysInstallDir)\PowerToys.ManagedCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PowerToys.Common.UI">
      <HintPath>$(PowerToysInstallDir)\PowerToys.Common.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PowerToys.Settings.UI.Lib">
      <HintPath>$(PowerToysInstallDir)\PowerToys.Settings.UI.Lib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Community.PowerToys.Run.Plugin.Snip.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\StyleCop.json" Link="StyleCop.json" />
    <Compile Include="$(MSBuildThisFileDirectory)..\GlobalSuppressions.cs" Link="GlobalSuppressions.cs" />
  </ItemGroup>

</Project>
